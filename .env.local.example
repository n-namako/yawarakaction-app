# このファイルをコピーして .env.local を作り、実際の値を入れてください。
# .env.local はgitignore対象なので、実際の値をコミットしても追跡されません（念のため直接コミットはしないこと）。

# --- LINEログイン（データ同期のためのアカウント識別用。通知はWeb Pushを使うのでMessaging APIは不要） ---
# LINE Developers Console (https://developers.line.biz/console/) で
# 1) 新しいプロバイダーを作成
# 2) 「LINEログイン」チャンネルを作成 → Channel ID / Channel Secret を取得
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- NextAuth ---
# NEXTAUTH_SECRET は下記コマンドなどで生成したランダム文字列を設定
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# 本番URL（Vercelにデプロイしたドメイン）。ローカル開発時は http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Supabase ---
# Supabase (https://supabase.com/) でプロジェクトを作成後、
# Project Settings > API から取得
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (Vercel Cron Jobsからのリクエストを認証するための秘密文字列) ---
# 任意のランダム文字列でOK（openssl rand -hex 16 など）
CRON_SECRET=

# --- Web Push通知用 VAPID鍵 ---
# Claudeが生成した値をそのまま使ってください（下のチャットに記載）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
